GEMINI_API_KEY=<Add-gemini-api-key>
OLLAMA_API_KEY=<Add-ollama-api-key>
PINECONE_API_KEY=<Add-pinecone-api-key>
PINECONE_INDEX_NAME=<Add-pinecone-index-name>
PINECONE_NAMESPACE=<Add-namespace>
PINECONE_EMBEDDINGS_JSONL_PATH=source/chunks/RAG demo embeddings.jsonl
PINECONE_BATCH_SIZE=100
PINECONE_EXPECTED_DIMENSION=768
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHUNKS_JSONL_PATH=source/chunks/RAG demo.jsonl
OLLAMA_CHUNKS_EMBEDDINGS_JSONL_PATH=source/chunks/RAG demo embeddings.jsonl
PINECONE_TOP_K=3
OLLAMA_CHAT_BASE_URL=https://ollama.com
OLLAMA_CHAT_MODEL=gpt-oss:20b-cloud
OLLAMA_CHAT_PATH=/api/chat
OLLAMA_ANSWER_TEMPERATURE=0
OLLAMA_ANSWER_NUM_PREDICT=300
OLLAMA_ROUTER_MODEL=gpt-oss:20b-cloud
OLLAMA_FINAL_MODEL=gpt-oss:120b-cloud
OLLAMA_EVAL_DATASET_PATH=LLM_evaluation/financial_services_mcq_eval.jsonl
OLLAMA_EVAL_RESULTS_PATH=LLM_evaluation/ollama_eval_results.jsonl
OLLAMA_EVAL_NUM_PREDICT=128
OLLAMA_CONSTRAINT_DATASET_PATH=LLM_evaluation/instruction_constraints_eval.jsonl
OLLAMA_CONSTRAINT_RESULTS_PATH=LLM_evaluation/instruction_constraint_eval_results.jsonl
OLLAMA_CONSTRAINT_GENERATE_NUM_PREDICT=300
OLLAMA_CONSTRAINT_JUDGE_NUM_PREDICT=300
